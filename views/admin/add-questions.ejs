<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
  <link href="/css/main.css" rel="stylesheet">
</head>
<body>
<%- include('../partials/header', { activePage: 'tests' }) %>

<div class="page-header">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h1><i class="bi bi-question-circle me-2"></i>Add Questions</h1>
        <p>
          Test: <strong><%= test.title %></strong> &nbsp;|&nbsp;
          Code: <span class="code-badge"><%= test.code %></span> &nbsp;|&nbsp;
          <%= questions.length %> question(s) added
        </p>
      </div>
      <a href="/admin/tests" class="btn btn-light">
        <i class="bi bi-arrow-left me-1"></i>Back to Tests
      </a>
    </div>
  </div>
</div>

<main class="container pb-5">
  <%- include('../partials/flash') %>

  <div class="row g-4">

    <!-- ── Excel Import Panel ───────────────────────── -->
    <div class="col-12">
      <div class="card border-0" style="background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border-left:4px solid #43a047 !important;">
        <div class="card-body py-3 px-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-file-earmark-excel text-success" style="font-size:2rem;"></i>
              <div>
                <div class="fw-bold">Bulk Import via Excel</div>
                <div class="text-muted small">Upload an .xlsx file to add multiple questions at once.</div>
              </div>
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <a href="/admin/questions/template" class="btn btn-sm btn-outline-success">
                <i class="bi bi-download me-1"></i>Download Template
              </a>
              <button class="btn btn-sm btn-success" type="button"
                      data-bs-toggle="collapse" data-bs-target="#importCollapse">
                <i class="bi bi-upload me-1"></i>Import Excel
              </button>
            </div>
          </div>

          <div class="collapse mt-3" id="importCollapse">
            <form action="/admin/tests/<%= test._id %>/import-questions" method="POST"
                  enctype="multipart/form-data" id="importForm">
              <div class="row g-2 align-items-end">
                <div class="col-12 col-md-8">
                  <label class="form-label small fw-semibold">Select Excel File (.xlsx or .xls)</label>
                  <input type="file" name="questionsFile" class="form-control" accept=".xlsx,.xls" required>
                </div>
                <div class="col-12 col-md-4">
                  <button type="submit" class="btn btn-success w-100" id="importBtn">
                    <i class="bi bi-cloud-upload me-1"></i>Upload & Import
                  </button>
                </div>
              </div>
              <div class="form-text mt-2">
                Required columns: <strong>Question, Option A, Option B, Option C, Option D, Correct Answer</strong>
                &nbsp;|&nbsp; Optional: Marks, Explanation
                &nbsp;|&nbsp; Correct Answer: A/B/C/D or 1/2/3/4
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Add Question Form ─────────────────────────── -->
    <div class="col-12 col-lg-5">
      <div class="card sticky-top" style="top:80px;">
        <div class="card-header">
          <span class="section-title"><i class="bi bi-plus-square me-2"></i>Add New Question</span>
        </div>
        <div class="card-body p-3">
          <form action="/admin/tests/<%= test._id %>/questions" method="POST" id="addQForm">

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0 fw-semibold">Question Text <span class="text-danger">*</span></label>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" onclick="insertCodeTemplate('addQuestionTextarea')" title="Insert Code Block">
                    <i class="bi bi-code-slash me-1"></i>Insert Code
                  </button>
                  <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="insertInlineCode('addQuestionTextarea')" title="Insert Inline Code">
                    <code>`code`</code>
                  </button>
                </div>
              </div>
              <textarea name="question" id="addQuestionTextarea" class="form-control" rows="4"
                        placeholder="Enter question or paste code here... (Supports code blocks and line-by-line formatting)" required
                        oninput="updateLivePreview(this, 'addQLivePreview', 'addQPreviewWrapper')"></textarea>

              <!-- Live Question & Code Preview -->
              <div class="mt-2 d-none" id="addQPreviewWrapper">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <small class="text-muted fw-bold"><i class="bi bi-eye me-1 text-primary"></i>Live Student Preview:</small>
                  <small class="text-muted" style="font-size:0.75rem;">Formatted with line-by-line code</small>
                </div>
                <div class="p-3 border rounded bg-white question-text" id="addQLivePreview"></div>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label fw-semibold">Options <span class="text-danger">*</span></label>
              <div class="d-flex flex-column gap-2">
                <div class="input-group">
                  <span class="input-group-text fw-bold bg-primary text-white border-0" style="width:38px;">A</span>
                  <input type="text" name="optA" class="form-control" placeholder="Option A" required>
                </div>
                <div class="input-group">
                  <span class="input-group-text fw-bold bg-primary text-white border-0" style="width:38px;">B</span>
                  <input type="text" name="optB" class="form-control" placeholder="Option B" required>
                </div>
                <div class="input-group">
                  <span class="input-group-text fw-bold bg-primary text-white border-0" style="width:38px;">C</span>
                  <input type="text" name="optC" class="form-control" placeholder="Option C" required>
                </div>
                <div class="input-group">
                  <span class="input-group-text fw-bold bg-primary text-white border-0" style="width:38px;">D</span>
                  <input type="text" name="optD" class="form-control" placeholder="Option D" required>
                </div>
              </div>
            </div>

            <div class="row g-2 mt-1">
              <div class="col-7">
                <label class="form-label">Correct Answer <span class="text-danger">*</span></label>
                <select name="correctAnswer" class="form-select" required>
                  <option value="" disabled selected>Select correct...</option>
                  <option value="0">A — Option A</option>
                  <option value="1">B — Option B</option>
                  <option value="2">C — Option C</option>
                  <option value="3">D — Option D</option>
                </select>
              </div>
              <div class="col-5">
                <label class="form-label">Marks</label>
                <input type="number" name="marks" class="form-control" value="1" min="1" max="10">
              </div>
            </div>

            <div class="mt-2">
              <label class="form-label">Explanation (optional)</label>
              <input type="text" name="explanation" class="form-control"
                     placeholder="Brief explanation of correct answer">
            </div>

            <hr>
            <button type="submit" class="btn btn-primary w-100" id="addQBtn">
              <i class="bi bi-plus-circle me-1"></i>Add Question
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- ── Questions List ─────────────────────────────── -->
    <div class="col-12 col-lg-7">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="section-title">
            <i class="bi bi-list-ol me-2"></i>
            Questions (<%= questions.length %>)
          </span>
          <% if (test.questionLimit > 0) { %>
          <span class="badge bg-info text-dark">
            Limit: <%= test.questionLimit %> per student
          </span>
          <% } %>
        </div>
        <div class="card-body p-0">
          <% if (questions.length === 0) { %>
            <div class="empty-state">
              <i class="bi bi-question-circle"></i>
              <p>No questions yet. Use the form to add the first question.</p>
            </div>
          <% } else { %>
            <div class="p-3 d-flex flex-column gap-3">
              <% questions.forEach((q, idx) => { %>
              <div class="border rounded-2 p-3 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="question-number">Q<%= idx + 1 %></span>
                  <div class="d-flex gap-1">
                    <a href="/admin/questions/<%= q._id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/questions/<%= q._id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this question?')">
                      <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
                <div class="question-text mb-2"><%- formatQuestion(q.question, { allowCopy: true }) %></div>
                <div class="d-flex flex-column gap-1">
                  <% q.options.forEach((opt, oIdx) => { %>
                  <div class="d-flex align-items-center gap-2 rounded px-2 py-1
                       <%= oIdx === q.correctAnswer ? 'bg-success bg-opacity-10 border border-success border-opacity-25' : 'bg-light' %>">
                    <span class="badge <%= oIdx === q.correctAnswer ? 'bg-success' : 'bg-secondary' %>"
                          style="width:22px;height:22px;display:flex;align-items:center;justify-content:center;">
                      <%= ['A','B','C','D'][oIdx] %>
                    </span>
                    <span style="font-size:0.85rem;"><%= opt %></span>
                    <% if (oIdx === q.correctAnswer) { %>
                      <i class="bi bi-check-circle-fill text-success ms-auto"></i>
                    <% } %>
                  </div>
                  <% }) %>
                </div>
                <% if (q.explanation) { %>
                <div class="mt-2 text-muted small">
                  <i class="bi bi-lightbulb me-1 text-warning"></i><%- formatQuestion(q.explanation) %>
                </div>
                <% } %>
                <div class="text-end mt-1">
                  <span class="badge bg-primary bg-opacity-10 text-primary"><%= q.marks %> mark(s)</span>
                </div>
              </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="/js/code-formatter.js"></script>
<script>
  function insertCodeTemplate(textareaId) {
    const ta = document.getElementById(textareaId);
    if (!ta) return;
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const selected = ta.value.substring(start, end);
    const template = '```c\n' + (selected || '// Paste code here\nint main() {\n    printf("Hello");\n    return 0;\n}') + '\n```\n';
    ta.value = ta.value.substring(0, start) + template + ta.value.substring(end);
    ta.focus();
    ta.dispatchEvent(new Event('input'));
  }

  function insertInlineCode(textareaId) {
    const ta = document.getElementById(textareaId);
    if (!ta) return;
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const selected = ta.value.substring(start, end) || 'code';
    const snippet = '`' + selected + '`';
    ta.value = ta.value.substring(0, start) + snippet + ta.value.substring(end);
    ta.focus();
    ta.dispatchEvent(new Event('input'));
  }

  function updateLivePreview(textarea, previewId, wrapperId) {
    const preview = document.getElementById(previewId);
    const wrapper = document.getElementById(wrapperId);
    if (!preview || !wrapper) return;
    const val = textarea.value.trim();
    if (!val) {
      wrapper.classList.add('d-none');
      preview.innerHTML = '';
      return;
    }
    wrapper.classList.remove('d-none');
    preview.innerHTML = window.parseQuestionText ? window.parseQuestionText(val) : val;
  }

  document.getElementById('addQForm').addEventListener('submit', function () {
    const btn = document.getElementById('addQBtn');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding...';
    btn.disabled = true;
  });
  // Import form spinner
  const importForm = document.getElementById('importForm');
  if (importForm) {
    importForm.addEventListener('submit', function () {
      const btn = document.getElementById('importBtn');
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Importing...';
      btn.disabled = true;
    });
  }
</script>
</body>
</html>
