<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%- include('../partials/pwa-head') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
  <link href="/css/main.css?v=2.1" rel="stylesheet">
  <style>
    /* Prevent text selection during test */
    body { user-select: none; -webkit-user-select: none; }
    /* Anti-cheat: strictly hide any code copy button during test */
    .code-copy-btn { display: none !important; }
    .test-progress-bar { height: 5px; background: var(--gray-200); }
    .test-progress-bar .fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--accent)); transition: width 0.3s; }
    .question-nav-btn {
      width: 36px; height: 36px;
      border-radius: 8px;
      border: 2px solid var(--gray-300);
      background: #fff;
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 700;
      transition: all 0.15s;
    }
    .question-nav-btn.answered   { background: var(--primary); color: #fff; border-color: var(--primary); }
    .question-nav-btn.current    { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(33,150,243,0.25); }
    .question-nav-btn:hover      { border-color: var(--accent); }
    .sidebar-panel { position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; }

    /* ── Live Proctoring Camera Bubble (Circular Bottom-Right) ── */
    .camera-proctor-box {
      position: fixed !important;
      bottom: 24px !important;
      right: 24px !important;
      width: 140px !important;
      height: 140px !important;
      background: #0f172a !important;
      border-radius: 50% !important;
      border: 3px solid #2563eb !important;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 4px rgba(37, 99, 235, 0.35) !important;
      z-index: 99999 !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      transition: all 0.25s ease !important;
      user-select: none !important;
    }
    .camera-proctor-box:hover {
      transform: scale(1.06);
      border-color: #38bdf8 !important;
      box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55), 0 0 0 5px rgba(56, 189, 248, 0.45) !important;
    }
    .camera-proctor-video-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .camera-proctor-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      transform: scaleX(-1);
      display: block;
    }
    .camera-badge {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(4px);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 5px;
      letter-spacing: 0.5px;
      z-index: 2;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      pointer-events: none;
      white-space: nowrap;
    }
    .camera-rec-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 6px #ef4444;
      animation: recPulse 1.2s infinite ease-in-out;
    }
    .camera-rec-dot.active {
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
    }
    @keyframes recPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }
    .camera-status-overlay {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8px;
      text-align: center;
      background: rgba(15, 23, 42, 0.94);
      color: #fff;
      z-index: 3;
    }
    .camera-status-overlay .spinner-border {
      width: 1.2rem;
      height: 1.2rem;
      border-width: 2px;
    }
    .camera-status-title {
      font-size: 0.7rem;
      font-weight: 700;
      margin-top: 4px;
      margin-bottom: 2px;
    }
    .camera-status-desc {
      display: none;
    }
    .camera-retry-btn {
      font-size: 0.62rem;
      padding: 2px 8px;
      border-radius: 20px;
      margin-top: 4px;
    }
    @media (max-width: 576px) {
      .camera-proctor-box {
        width: 110px !important;
        height: 110px !important;
        bottom: 16px !important;
        right: 16px !important;
        border-width: 2px !important;
      }
      .camera-badge {
        font-size: 0.55rem;
        padding: 1px 5px;
        bottom: 5px;
      }
      .camera-status-title {
        font-size: 0.62rem;
      }
    }
  </style>
</head>
<body>

<!-- ═══════════════ STICKY TEST HEADER ═══════════════════ -->
<div class="test-header" id="testHeader">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <span class="fw-bold text-white"><%= test.title %></span>
        <span class="badge bg-white text-primary ms-2"><%= test.domain %></span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="text-white small">
          <i class="bi bi-question-circle me-1"></i>
          <span id="answeredCount">0</span>/<%= questions.length %>
        </div>
        <div class="timer-display" id="timerDisplay">
          <%= String(Math.floor(durationSeconds/60)).padStart(2,'0') %>:<%= String(durationSeconds%60).padStart(2,'0') %>
        </div>
        <button class="btn btn-warning btn-sm fw-semibold" onclick="confirmSubmit()">
          <i class="bi bi-send-check me-1"></i>Submit
        </button>
      </div>
    </div>
  </div>
  <!-- Progress bar -->
  <div class="test-progress-bar">
    <div class="fill" id="progressFill" style="width:0%"></div>
  </div>
</div>

<!-- ═══════════════ TAB SWITCH WARNING MODAL ══════════════ -->
<div class="modal fade" id="tabWarningModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-warning border-2">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Warning!</h5>
      </div>
      <div class="modal-body text-center">
        <i class="bi bi-eye-slash-fill text-warning" style="font-size:3rem;"></i>
        <h5 class="mt-3">Tab Switch Detected!</h5>
        <p class="text-muted mb-1">You left the test window.</p>
        <p>Warning <strong id="warningCount">1</strong> of <strong>3</strong></p>
        <div class="alert alert-danger border-0 mb-0">
          After 3 warnings, your test will be <strong>automatically submitted</strong>.
        </div>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-warning fw-bold px-4" onclick="dismissWarning()">
          <i class="bi bi-arrow-return-left me-1"></i>Return to Test
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ SUBMIT CONFIRM MODAL ═════════════════ -->
<div class="modal fade" id="submitModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Submit Test?</h5>
      </div>
      <div class="modal-body">
        <p class="text-muted">You have answered <strong id="submitAnsweredCount">0</strong> of <strong><%= questions.length %></strong> questions.</p>
        <div class="alert alert-warning border-0 small">
          <i class="bi bi-exclamation-triangle me-1"></i>
          Once submitted, you cannot attempt this test again.
        </div>
      </div>
      <div class="modal-footer border-0">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal" id="cancelSubmitBtn">Cancel</button>
        <button class="btn btn-primary fw-semibold" onclick="performSubmit()">
          <i class="bi bi-send-check me-1"></i>Yes, Submit
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ MAIN CONTENT ══════════════════════════ -->
<main class="container py-4">
  <div class="row g-4">

    <!-- Questions Column -->
    <div class="col-12 col-lg-9">
      <% questions.forEach((q, idx) => { %>
      <div class="question-card" id="question-<%= idx %>">
        <div class="p-3 pb-2 d-flex align-items-center gap-2">
          <span class="question-number">Q <%= idx + 1 %></span>
          <span class="ms-auto badge bg-primary bg-opacity-10 text-primary small">
            <%= q.marks %> mark<%= q.marks > 1 ? 's' : '' %>
          </span>
        </div>
        <div class="px-3 pb-1">
          <div class="question-text"><%- formatQuestion(q.question, { allowCopy: false }) %></div>
        </div>
        <div class="px-3 pb-3">
          <% q.options.forEach((opt, oIdx) => { %>
          <label class="option-label" id="opt-<%= idx %>-<%= oIdx %>"
                 for="q_<%= idx %>_<%= oIdx %>">
            <input type="radio" class="option-input"
                   id="q_<%= idx %>_<%= oIdx %>"
                   name="q_<%= idx %>"
                   value="<%= oIdx %>"
                   data-qidx="<%= idx %>"
                   data-qid="<%= q._id %>">
            <div class="option-letter"><%= ['A','B','C','D'][oIdx] %></div>
            <span><%= opt %></span>
          </label>
          <% }) %>
        </div>
      </div>
      <% }) %>

      <div class="text-center mt-2">
        <button class="btn btn-primary btn-lg px-5 fw-bold" onclick="confirmSubmit()">
          <i class="bi bi-send-check me-2"></i>Submit Test
        </button>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-12 col-lg-3">
      <div class="sidebar-panel">

        <!-- Question Navigator -->
        <div class="card mb-3">
          <div class="card-header py-2">
            <small class="fw-bold text-uppercase text-muted letter-spacing">Question Navigator</small>
          </div>
          <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-1" id="questionNav">
              <% questions.forEach((q, idx) => { %>
              <button class="question-nav-btn" id="nav-<%= idx %>"
                      onclick="scrollToQuestion(<%= idx %>)">
                <%= idx + 1 %>
              </button>
              <% }) %>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
              <div class="d-flex align-items-center gap-1 small text-muted">
                <div style="width:14px;height:14px;border-radius:3px;background:var(--primary);"></div> Answered
              </div>
              <div class="d-flex align-items-center gap-1 small text-muted">
                <div style="width:14px;height:14px;border-radius:3px;border:2px solid #ccc;"></div> Not Answered
              </div>
            </div>
          </div>
        </div>

        <!-- Timer Card -->
        <div class="card mb-3">
          <div class="card-body text-center py-3">
            <div class="text-muted small mb-1">Time Remaining</div>
            <div class="timer-display d-inline-block" id="sidebarTimer" style="font-size:1.3rem;">
              <%= String(Math.floor(durationSeconds/60)).padStart(2,'0') %>:<%= String(durationSeconds%60).padStart(2,'0') %>
            </div>
          </div>
        </div>

        <!-- Anti-cheat status -->
        <div class="card text-center">
          <div class="card-body py-2">
            <div class="text-muted small mb-1">Tab Switches</div>
            <div class="fw-bold fs-5" id="tabSwitchDisplay">0 / 3</div>
            <div class="mt-1 small text-danger d-none" id="tabWarnText">
              <i class="bi bi-exclamation-triangle me-1"></i>Warnings active!
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<!-- ═══════════════ LIVE PROCTORING CAMERA (BOTTOM-RIGHT) ══════════════ -->
<div class="camera-proctor-box" id="cameraProctorBox" title="Webcam Proctoring Active">
  <div class="camera-proctor-video-wrap">
    <div class="camera-badge" id="cameraBadge">
      <span class="camera-rec-dot" id="cameraRecDot"></span>
      <span id="cameraBadgeText">REC</span>
    </div>
    <video id="proctorVideo" class="camera-proctor-video" autoplay playsinline muted></video>

    <!-- Status / Error Overlay -->
    <div class="camera-status-overlay" id="cameraStatusOverlay">
      <div class="spinner-border text-primary mb-1" role="status" id="cameraSpinner"></div>
      <i class="bi bi-camera-video-off text-danger fs-4 d-none mb-1" id="cameraErrorIcon"></i>
      <div class="camera-status-title" id="cameraStatusTitle">Starting Camera...</div>
      <div class="camera-status-desc" id="cameraStatusDesc">Please allow camera access for proctoring.</div>
      <button class="btn btn-sm btn-primary camera-retry-btn d-none" id="cameraRetryBtn" onclick="initCamera(true)">
        <i class="bi bi-arrow-clockwise me-1"></i>Enable Camera
      </button>
    </div>
  </div>
</div>

<!-- Bootstrap JS & Code Formatter -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="/js/code-formatter.js"></script>

<script>
// ═══════════════════════════════════════════════════════════
//  APARAITECH TEST ENGINE — Anti-Cheat, Persistence & Submit
// ═══════════════════════════════════════════════════════════

const TOTAL_QUESTIONS  = <%= questions.length %>;
const DURATION_SECONDS = <%= durationSeconds %>;
const TEST_ID          = '<%= test._id %>';
const MAX_TAB_WARNINGS = 3;
const STORAGE_KEY      = `aparaitech_test_${TEST_ID}`;

// State
let timeLeft                = DURATION_SECONDS;
let startTime               = Date.now();
let tabSwitchCount          = 0;
let submitted               = false;
let timerInterval           = null;
let answers                 = {};
let cameraStream            = null;
let cameraKeepAliveInterval = null;

// Bootstrap modals
const tabWarningModal = new bootstrap.Modal(document.getElementById('tabWarningModal'), { backdrop: 'static' });
const submitModal     = new bootstrap.Modal(document.getElementById('submitModal'), { backdrop: 'static' });

// ── PERSISTENCE: Save to localStorage ────────────────────
function saveProgress() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({
      answers,
      timeLeft,
      tabSwitchCount,
      savedAt: Date.now()
    }));
  } catch(e) {}
}

// ── PERSISTENCE: Load from localStorage ──────────────────
function loadProgress() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return false;
    const data = JSON.parse(saved);

    // Ignore saved state older than test duration (already expired)
    const ageSeconds = (Date.now() - data.savedAt) / 1000;
    if (ageSeconds > DURATION_SECONDS) {
      localStorage.removeItem(STORAGE_KEY);
      return false;
    }

    // Restore answers
    answers = data.answers || {};

    // Restore timer (subtract time elapsed since save)
    const elapsed = Math.floor(ageSeconds);
    timeLeft = Math.max(0, (data.timeLeft || DURATION_SECONDS) - elapsed);

    // Restore tab switch count
    tabSwitchCount = data.tabSwitchCount || 0;

    return Object.keys(answers).length > 0;
  } catch(e) {
    return false;
  }
}

// ── PERSISTENCE: Restore UI from saved answers ───────────
function restoreUI() {
  const questionEls = document.querySelectorAll('.option-input');
  questionEls.forEach(input => {
    const qId  = input.dataset.qid;
    const qIdx = parseInt(input.dataset.qidx);
    const oIdx = parseInt(input.value);

    if (answers[qId] !== undefined && answers[qId] === oIdx) {
      input.checked = true;
      const label = document.getElementById(`opt-${qIdx}-${oIdx}`);
      if (label) label.classList.add('selected');
      document.getElementById(`nav-${qIdx}`)?.classList.add('answered');
    }
  });

  // Restore tab switch display
  document.getElementById('tabSwitchDisplay').textContent = `${tabSwitchCount} / 3`;
  if (tabSwitchCount > 0) {
    document.getElementById('tabWarnText')?.classList.remove('d-none');
  }

  updateAnsweredCount();
}

// ── CLEAR saved progress after submit ────────────────────
function clearProgress() {
  try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
}

// ── LIVE WEBCAM PROCTORING (BOTTOM-RIGHT) ────────────────
async function initCamera(userTriggered = false) {
  const overlay     = document.getElementById('cameraStatusOverlay');
  const spinner     = document.getElementById('cameraSpinner');
  const errorIcon   = document.getElementById('cameraErrorIcon');
  const title       = document.getElementById('cameraStatusTitle');
  const desc        = document.getElementById('cameraStatusDesc');
  const retryBtn    = document.getElementById('cameraRetryBtn');
  const video       = document.getElementById('proctorVideo');
  const badgeDot    = document.getElementById('cameraRecDot');
  const badgeText   = document.getElementById('cameraBadgeText');

  if (overlay)   overlay.classList.remove('d-none');
  if (spinner)   spinner.classList.remove('d-none');
  if (errorIcon) errorIcon.classList.add('d-none');
  if (retryBtn)  retryBtn.classList.add('d-none');
  if (title)     title.textContent = 'Starting Camera...';
  if (desc)      desc.textContent = 'Please allow camera access when prompted.';

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    if (spinner)   spinner.classList.add('d-none');
    if (errorIcon) errorIcon.classList.remove('d-none');
    if (title)     title.textContent = 'Camera Not Supported';
    if (desc)      desc.textContent = 'Your browser does not support webcam access or page is not served securely.';
    return;
  }

  try {
    // If an existing stream is active, stop old tracks first
    if (cameraStream) {
      cameraStream.getTracks().forEach(t => {
        try { t.stop(); } catch(e) {}
      });
      cameraStream = null;
    }

    try {
      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: 'user',
          width: { ideal: 640 },
          height: { ideal: 480 }
        },
        audio: false
      });
    } catch (constraintErr) {
      console.warn('Constrained camera request failed, falling back to basic video:', constraintErr);
      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: true,
        audio: false
      });
    }

    if (video) {
      video.muted = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('autoplay', '');
      video.srcObject = cameraStream;
      try {
        await video.play();
      } catch (playErr) {
        console.warn('Camera video play caught:', playErr);
      }
    }

    if (overlay)   overlay.classList.add('d-none');
    if (badgeDot)  badgeDot.classList.add('active');
    if (badgeText) badgeText.textContent = 'REC';

    // Watch for stream termination
    const videoTrack = cameraStream.getVideoTracks()[0];
    if (videoTrack) {
      videoTrack.onended = () => {
        if (!submitted) {
          showCameraError('Camera Disconnected', 'Your webcam stream stopped. Please reconnect.');
        }
      };
    }

    // Keep-alive check every 5 seconds to ensure camera is still streaming
    if (!cameraKeepAliveInterval) {
      cameraKeepAliveInterval = setInterval(() => {
        if (submitted) return;
        if (!cameraStream || !cameraStream.active) {
          showCameraError('Camera Inactive', 'Continuous webcam proctoring is required.');
        }
      }, 5000);
    }
  } catch (err) {
    console.warn('Camera initialization failed:', err);
    if (spinner)   spinner.classList.add('d-none');
    if (errorIcon) errorIcon.classList.remove('d-none');
    if (retryBtn)  retryBtn.classList.remove('d-none');

    if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
      if (title) title.textContent = 'Camera Blocked';
      if (desc)  desc.textContent = 'Camera permission is required. Allow access in browser settings and click retry.';
    } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
      if (title) title.textContent = 'Webcam Not Found';
      if (desc)  desc.textContent = 'No webcam was detected on this device. Please connect a webcam.';
    } else {
      if (title) title.textContent = 'Camera Error';
      if (desc)  desc.textContent = err.message || 'Unable to start camera.';
    }
  }
}

function showCameraError(msgTitle, msgDesc) {
  const overlay   = document.getElementById('cameraStatusOverlay');
  const spinner   = document.getElementById('cameraSpinner');
  const errorIcon = document.getElementById('cameraErrorIcon');
  const title     = document.getElementById('cameraStatusTitle');
  const desc      = document.getElementById('cameraStatusDesc');
  const retryBtn  = document.getElementById('cameraRetryBtn');
  const badgeDot  = document.getElementById('cameraRecDot');
  const badgeText = document.getElementById('cameraBadgeText');

  if (overlay)   overlay.classList.remove('d-none');
  if (spinner)   spinner.classList.add('d-none');
  if (errorIcon) errorIcon.classList.remove('d-none');
  if (retryBtn)  retryBtn.classList.remove('d-none');
  if (title)     title.textContent = msgTitle;
  if (desc)      desc.textContent = msgDesc;
  if (badgeDot)  badgeDot.classList.remove('active');
  if (badgeText) badgeText.textContent = 'CAM OFF';
}

function stopCamera() {
  if (cameraKeepAliveInterval) {
    clearInterval(cameraKeepAliveInterval);
    cameraKeepAliveInterval = null;
  }
  if (cameraStream) {
    cameraStream.getTracks().forEach(track => {
      try { track.stop(); } catch(e) {}
    });
    cameraStream = null;
  }
  const video = document.getElementById('proctorVideo');
  if (video) {
    video.srcObject = null;
  }
}

// ── FULLSCREEN ────────────────────────────────────────────
function enterFullscreen() {
  try {
    const el = document.documentElement;
    const req = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
    if (req) {
      const p = req.call(el);
      if (p && typeof p.catch === 'function') {
        p.catch(() => {});
      }
    }
  } catch (err) {}
}

// ── BOOT TEST ENGINE & CAMERA ─────────────────────────────
function bootTestEngine() {
  // 1. Immediately start live circular camera proctoring
  initCamera();

  // 2. Request fullscreen safely
  enterFullscreen();

  // 3. Load or initialize test state
  const wasRestored = loadProgress();
  if (wasRestored) {
    restoreUI();
    showRestoredBanner();
    timeLeft = Math.min(timeLeft, DURATION_SECONDS);
  } else {
    timeLeft = DURATION_SECONDS;
  }

  const timerDisplay = document.getElementById('timerDisplay');
  if (timerDisplay) timerDisplay.textContent = formatTime(timeLeft);
  const sidebarTimer = document.getElementById('sidebarTimer');
  if (sidebarTimer) sidebarTimer.textContent = formatTime(timeLeft);
  startTimer();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', bootTestEngine);
} else {
  bootTestEngine();
}

// ── Show "Answers Restored" banner ───────────────────────
function showRestoredBanner() {
  const banner = document.createElement('div');
  banner.className = 'alert alert-success alert-dismissible fade show mx-3 mt-2 small py-2';
  banner.style.cssText = 'position:fixed;top:70px;left:50%;transform:translateX(-50%);z-index:9999;min-width:300px;text-align:center;';
  banner.innerHTML = `
    <i class="bi bi-check-circle-fill me-1"></i>
    <strong>Progress Restored!</strong> Your previous answers have been loaded.
    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>`;
  document.body.appendChild(banner);
  setTimeout(() => banner.remove(), 4000);
}

// Re-enter fullscreen if user exits
document.addEventListener('fullscreenchange', () => {
  if (!document.fullscreenElement && !submitted) {
    enterFullscreen();
    handleTabSwitch();
  }
});

// ── TIMER ─────────────────────────────────────────────────
function startTimer() {
  let tickCount = 0;
  timerInterval = setInterval(() => {
    timeLeft--;
    tickCount++;
    updateTimerUI();
    // Save progress every 10 seconds
    if (tickCount % 10 === 0) saveProgress();
    if (timeLeft <= 0) {
      clearInterval(timerInterval);
      autoSubmit('timer');
    }
  }, 1000);
}

function formatTime(seconds) {
  const m = Math.floor(seconds / 60).toString().padStart(2, '0');
  const s = (seconds % 60).toString().padStart(2, '0');
  return `${m}:${s}`;
}

function updateTimerUI() {
  const formatted = formatTime(timeLeft);
  const td = document.getElementById('timerDisplay');
  const st = document.getElementById('sidebarTimer');
  [td, st].forEach(el => {
    el.textContent = formatted;
    el.classList.remove('warning', 'danger');
    if (timeLeft <= 60)  el.classList.add('danger');
    else if (timeLeft <= 300) el.classList.add('warning');
  });
}

// ── ANTI-CHEAT: TAB SWITCH ────────────────────────────────
document.addEventListener('visibilitychange', () => {
  if (document.hidden && !submitted) handleTabSwitch();
});

window.addEventListener('blur', () => {
  if (!submitted) handleTabSwitch();
});

function handleTabSwitch() {
  if (submitted) return;
  tabSwitchCount++;
  document.getElementById('tabSwitchDisplay').textContent = `${tabSwitchCount} / 3`;

  if (tabSwitchCount >= MAX_TAB_WARNINGS) {
    autoSubmit('tab-limit');
    return;
  }

  if (tabSwitchCount > 0) {
    document.getElementById('tabWarnText').classList.remove('d-none');
  }

  document.getElementById('warningCount').textContent = tabSwitchCount;
  tabWarningModal.show();
}

function dismissWarning() {
  tabWarningModal.hide();
  enterFullscreen();
}

// ── ANTI-CHEAT: DISABLE RIGHT-CLICK ──────────────────────
document.addEventListener('contextmenu', e => e.preventDefault());

// ── ANTI-CHEAT: DISABLE COPY/PASTE ───────────────────────
document.addEventListener('copy',  e => e.preventDefault());
document.addEventListener('cut',   e => e.preventDefault());
document.addEventListener('paste', e => e.preventDefault());

// ── ANTI-CHEAT: BLOCK KEYBOARD SHORTCUTS ─────────────────
document.addEventListener('keydown', (e) => {
  // Block F12, Ctrl+U, Ctrl+Shift+I, Ctrl+S, Ctrl+A, Alt+Tab
  if (
    e.key === 'F12' ||
    (e.ctrlKey && ['u','s','a','c','v','p'].includes(e.key.toLowerCase())) ||
    (e.ctrlKey && e.shiftKey && ['i','j','c'].includes(e.key.toLowerCase())) ||
    (e.altKey && e.key === 'Tab')
  ) {
    e.preventDefault();
  }
});

// ── ANSWER TRACKING ───────────────────────────────────────
document.querySelectorAll('.option-input').forEach(input => {
  input.addEventListener('change', () => {
    const qIdx = parseInt(input.dataset.qidx);
    const qId  = input.dataset.qid;
    const val  = parseInt(input.value);

    // Store answer
    answers[qId] = val;

    // Update option styling in this question
    document.querySelectorAll(`[name="q_${qIdx}"]`).forEach((radio, oIdx) => {
      const label = document.getElementById(`opt-${qIdx}-${oIdx}`);
      label.classList.toggle('selected', oIdx === val);
    });

    // Update nav button
    document.getElementById(`nav-${qIdx}`).classList.add('answered');

    // Update answered count
    updateAnsweredCount();

    // Save progress to localStorage
    saveProgress();
  });
});

function updateAnsweredCount() {
  const count = Object.keys(answers).length;
  document.getElementById('answeredCount').textContent = count;
  document.getElementById('progressFill').style.width = `${(count / TOTAL_QUESTIONS) * 100}%`;
}

// ── QUESTION NAVIGATOR ────────────────────────────────────
function scrollToQuestion(idx) {
  document.getElementById(`question-${idx}`)
          .scrollIntoView({ behavior: 'smooth', block: 'center' });
  // Mark current (optional visual)
  document.querySelectorAll('.question-nav-btn').forEach((btn, i) => {
    btn.classList.toggle('current', i === idx);
  });
}

// ── SUBMIT FLOW ───────────────────────────────────────────
function confirmSubmit() {
  if (submitted) return;
  document.getElementById('submitAnsweredCount').textContent = Object.keys(answers).length;
  submitModal.show();
}

function autoSubmit(reason) {
  if (submitted) return;
  console.log('Auto-submit triggered by:', reason);
  // Close modals
  try { tabWarningModal.hide(); submitModal.hide(); } catch(e) {}
  performSubmit();
}

async function performSubmit() {
  if (submitted) return;
  submitted = true;
  clearInterval(timerInterval);
  stopCamera(); // Stop camera proctoring when test ends

  // Disable UI
  document.querySelectorAll('.option-input, button').forEach(el => el.disabled = true);

  const timeTaken = Math.round((Date.now() - startTime) / 1000);

  try {
    const response = await fetch(`/student/test/${TEST_ID}/submit`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        answers:        answers,
        timeTaken:      timeTaken,
        tabSwitchCount: tabSwitchCount
      })
    });

    const data = await response.json();

    if (data.redirect) {
      clearProgress(); // Remove saved state after successful submit
      // Exit fullscreen before redirecting
      if (document.exitFullscreen) document.exitFullscreen();
      window.location.href = data.redirect;
    } else if (data.error) {
      alert('Submission error: ' + data.error);
      submitted = false;
      initCamera();
    }
  } catch (err) {
    console.error('Submission failed:', err);
    alert('Network error during submission. Please contact admin immediately.');
    submitted = false;
    initCamera();
  }
}

// ── PAGE UNLOAD / REFRESH PROTECTION ─────────────────────
window.addEventListener('beforeunload', (e) => {
  if (!submitted) {
    saveProgress(); // Save before leaving
    e.preventDefault();
    e.returnValue = 'Your test is in progress. Your answers are saved — you can return to continue.';
    return e.returnValue;
  } else {
    stopCamera();
  }
});

window.addEventListener('pagehide', () => {
  stopCamera();
});

// ─────────────────────────────────────────────────────────
</script>
</body>
</html>
