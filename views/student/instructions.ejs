<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%- include('../partials/pwa-head') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css?v=2.1" rel="stylesheet">
  <style>
    /* Inlined Camera Proctoring Styles to guarantee perfect display */
    .camera-proctor-box {
      position: fixed !important;
      bottom: 24px !important;
      right: 24px !important;
      width: 140px !important;
      height: 140px !important;
      background: #0f172a !important;
      border-radius: 50% !important;
      border: 3px solid #2563eb !important;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 4px rgba(37, 99, 235, 0.35) !important;
      z-index: 99999 !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      transition: all 0.25s ease !important;
      user-select: none !important;
    }
    .camera-proctor-box:hover {
      transform: scale(1.06);
      border-color: #38bdf8 !important;
      box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55), 0 0 0 5px rgba(56, 189, 248, 0.45) !important;
    }
    .camera-proctor-box-static {
      position: relative !important;
      width: 120px !important;
      height: 120px !important;
      background: #0f172a !important;
      border-radius: 50% !important;
      border: 3px solid #2563eb !important;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25) !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
    }
    .camera-proctor-video-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .camera-proctor-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      transform: scaleX(-1);
      display: block;
    }
    .camera-badge {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(4px);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 5px;
      letter-spacing: 0.5px;
      z-index: 2;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      pointer-events: none;
      white-space: nowrap;
    }
    .camera-rec-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 6px #ef4444;
      animation: recPulse 1.2s infinite ease-in-out;
    }
    .camera-rec-dot.active {
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
    }
    @keyframes recPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }
    .camera-status-overlay {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8px;
      text-align: center;
      background: rgba(15, 23, 42, 0.94);
      color: #fff;
      z-index: 3;
    }
    .camera-status-overlay .spinner-border {
      width: 1.2rem;
      height: 1.2rem;
      border-width: 2px;
    }
    .camera-status-title {
      font-size: 0.7rem;
      font-weight: 700;
      margin-top: 4px;
      margin-bottom: 2px;
    }
    .camera-retry-btn {
      font-size: 0.62rem;
      padding: 2px 8px;
      border-radius: 20px;
      margin-top: 4px;
    }
    @media (max-width: 576px) {
      .camera-proctor-box {
        width: 110px !important;
        height: 110px !important;
        bottom: 16px !important;
        right: 16px !important;
        border-width: 2px !important;
      }
      .camera-proctor-box-static {
        width: 100px !important;
        height: 100px !important;
        border-width: 2px !important;
      }
    }
  </style>
</head>
<body>
<%- include('../partials/header', { activePage: 'test' }) %>

<div class="page-header">
  <div class="container">
    <h1><i class="bi bi-info-circle me-2"></i>Test Instructions</h1>
    <p>Please read carefully and verify your camera before you begin.</p>
  </div>
</div>

<main class="container pb-5" style="max-width:700px;">
  <%- include('../partials/flash') %>

  <div class="card mb-4 fade-in">
    <div class="card-header d-flex align-items-center justify-content-between">
      <span class="section-title"><i class="bi bi-journal-text me-2"></i><%= test.title %></span>
      <span class="badge bg-primary"><%= test.domain %></span>
    </div>
    <div class="card-body">
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 text-center">
          <div class="p-3 rounded-2 bg-primary bg-opacity-10">
            <i class="bi bi-clock text-primary fs-3 d-block mb-1"></i>
            <div class="fw-bold fs-5"><%= test.duration %> min</div>
            <div class="text-muted small">Duration</div>
          </div>
        </div>
        <div class="col-6 col-md-3 text-center">
          <div class="p-3 rounded-2 bg-success bg-opacity-10">
            <i class="bi bi-question-circle text-success fs-3 d-block mb-1"></i>
            <div class="fw-bold fs-5"><%= questionCount %></div>
            <div class="text-muted small">Questions</div>
          </div>
        </div>
        <div class="col-6 col-md-3 text-center">
          <div class="p-3 rounded-2 bg-warning bg-opacity-10">
            <i class="bi bi-award text-warning fs-3 d-block mb-1"></i>
            <div class="fw-bold fs-5"><%= test.totalMarks %></div>
            <div class="text-muted small">Total Marks</div>
          </div>
        </div>
        <div class="col-6 col-md-3 text-center">
          <div class="p-3 rounded-2 bg-info bg-opacity-10">
            <i class="bi bi-check-circle text-info fs-3 d-block mb-1"></i>
            <div class="fw-bold fs-5">
              <%= test.passingMarks > 0 ? test.passingMarks : Math.ceil(test.totalMarks * 0.4) %>
            </div>
            <div class="text-muted small">Passing Marks</div>
          </div>
        </div>
      </div>

      <!-- General Instructions -->
      <h6 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-primary"></i>General Instructions</h6>
      <ul class="list-group list-group-flush mb-3">
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-shuffle text-primary me-2"></i>
          Questions will be <strong>randomized</strong> and options will be <strong>shuffled</strong> for each student.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-clock-history text-warning me-2"></i>
          The test will <strong>auto-submit</strong> when the timer reaches zero.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-arrow-counterclockwise text-danger me-2"></i>
          <strong>Do not refresh or navigate away</strong> — the test will auto-submit if you do.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-display text-danger me-2"></i>
          You will be asked to enter <strong>fullscreen mode</strong>. Exiting fullscreen will trigger a warning.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-eye-slash text-danger me-2"></i>
          <strong>Tab switching</strong> is monitored. After <strong>3 warnings</strong>, the test auto-submits.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-camera-video-fill text-danger me-2"></i>
          <strong>Webcam Proctoring:</strong> Your camera will turn <strong>ON</strong> and remain continuously displayed in the bottom-right corner from the start of the test until you submit. Please allow camera permissions.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-hand-index text-muted me-2"></i>
          Right-click and copy/paste are <strong>disabled</strong> during the test.
        </li>
        <li class="list-group-item ps-0 border-0 pb-2">
          <i class="bi bi-check2-all text-success me-2"></i>
          You can attempt each test <strong>only once</strong>.
        </li>
      </ul>

      <% if (test.instructions) { %>
      <div class="alert alert-info border-0 mb-3">
        <h6 class="fw-bold mb-1"><i class="bi bi-chat-quote me-1"></i>Admin Instructions</h6>
        <p class="mb-0 small"><%= test.instructions %></p>
      </div>
      <% } %>

      <!-- ═══════════════ WEBCAM PROCTORING CHECK (BEFORE TEST START) ══════════════ -->
      <div class="card border border-primary border-opacity-25 bg-light mb-4 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3 flex-wrap flex-sm-nowrap">
            <!-- Circular Camera Preview -->
            <div class="camera-proctor-box-static">
              <div class="camera-proctor-video-wrap">
                <div class="camera-badge">
                  <span class="camera-rec-dot" id="instRecDot"></span>
                  <span id="instBadgeText">REC</span>
                </div>
                <video id="instructionsVideo" class="camera-proctor-video" autoplay playsinline muted></video>
                <div class="camera-status-overlay" id="instructionsOverlay">
                  <div class="spinner-border text-primary mb-1" role="status" id="instSpinner"></div>
                  <i class="bi bi-camera-video-off text-danger fs-4 d-none mb-1" id="instErrorIcon"></i>
                  <div class="camera-status-title" id="instStatusTitle">Starting Camera...</div>
                  <button type="button" class="btn btn-sm btn-primary camera-retry-btn d-none" id="instRetryBtn" onclick="initInstructionsCamera()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Enable Camera
                  </button>
                </div>
              </div>
            </div>

            <!-- Text & Instructions -->
            <div class="flex-grow-1">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                <h6 class="fw-bold mb-0 text-dark">
                  <i class="bi bi-camera-video-fill text-primary me-1"></i>Webcam Proctoring Check
                </h6>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 d-none" id="instVerifiedBadge">
                  <i class="bi bi-check-circle-fill me-1"></i>Camera Active
                </span>
              </div>
              <p class="text-muted small mb-2">
                This test requires continuous webcam proctoring. Your camera will remain visible in the bottom-right circular bubble throughout the test. Ensure your face is centered and clearly visible.
              </p>
              <button type="button" class="btn btn-sm btn-outline-primary" id="instTriggerBtn" onclick="initInstructionsCamera()">
                <i class="bi bi-camera-video me-1"></i>Test / Enable Camera
              </button>
            </div>
          </div>
        </div>
      </div>

      <hr>
      <div class="d-flex gap-3 justify-content-between align-items-center flex-wrap">
        <a href="/student/enter-code" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i>Back
        </a>
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="agreeCheck">
          <label class="form-check-label small" for="agreeCheck">
            I have read all instructions and I'm ready to begin.
          </label>
        </div>
        <a href="/student/test/<%= test._id %>/start" class="btn btn-primary px-4 disabled" id="startBtn" style="pointer-events:none;opacity:0.6;">
          <i class="bi bi-play-fill me-1"></i>Start Test
        </a>
      </div>
    </div>
  </div>
</main>

<!-- ═══════════════ LIVE PROCTORING FLOATING BUBBLE (BOTTOM-RIGHT) ══════════════ -->
<div class="camera-proctor-box" id="floatingCameraBox" title="Webcam Proctoring Preview">
  <div class="camera-proctor-video-wrap">
    <div class="camera-badge">
      <span class="camera-rec-dot" id="floatRecDot"></span>
      <span id="floatBadgeText">REC</span>
    </div>
    <video id="floatingVideo" class="camera-proctor-video" autoplay playsinline muted></video>
    <div class="camera-status-overlay" id="floatingOverlay">
      <div class="spinner-border text-primary mb-1" role="status" id="floatSpinner"></div>
      <i class="bi bi-camera-video-off text-danger fs-4 d-none mb-1" id="floatErrorIcon"></i>
      <div class="camera-status-title" id="floatStatusTitle">Camera Check</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  let instStream = null;

  async function initInstructionsCamera() {
    const overlay       = document.getElementById('instructionsOverlay');
    const spinner       = document.getElementById('instSpinner');
    const errorIcon     = document.getElementById('instErrorIcon');
    const title         = document.getElementById('instStatusTitle');
    const retryBtn      = document.getElementById('instRetryBtn');
    const video         = document.getElementById('instructionsVideo');
    const floatVideo    = document.getElementById('floatingVideo');
    const floatOverlay  = document.getElementById('floatingOverlay');
    const instRecDot    = document.getElementById('instRecDot');
    const floatRecDot   = document.getElementById('floatRecDot');
    const verifiedBadge = document.getElementById('instVerifiedBadge');
    const triggerBtn    = document.getElementById('instTriggerBtn');

    if (overlay)   overlay.classList.remove('d-none');
    if (spinner)   spinner.classList.remove('d-none');
    if (errorIcon) errorIcon.classList.add('d-none');
    if (retryBtn)  retryBtn.classList.add('d-none');
    if (title)     title.textContent = 'Starting Camera...';

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      if (spinner)   spinner.classList.add('d-none');
      if (errorIcon) errorIcon.classList.remove('d-none');
      if (title)     title.textContent = 'Camera Not Supported';
      return;
    }

    try {
      if (instStream) {
        instStream.getTracks().forEach(t => { try { t.stop(); } catch(e) {} });
        instStream = null;
      }

      try {
        instStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false
        });
      } catch (e1) {
        instStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
      }

      if (video) {
        video.muted = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('autoplay', '');
        video.srcObject = instStream;
        await video.play().catch(e => console.warn(e));
      }

      if (floatVideo) {
        floatVideo.muted = true;
        floatVideo.setAttribute('playsinline', '');
        floatVideo.setAttribute('autoplay', '');
        floatVideo.srcObject = instStream;
        await floatVideo.play().catch(e => console.warn(e));
      }

      if (overlay)      overlay.classList.add('d-none');
      if (floatOverlay) floatOverlay.classList.add('d-none');
      if (instRecDot)   instRecDot.classList.add('active');
      if (floatRecDot)  floatRecDot.classList.add('active');
      if (verifiedBadge) verifiedBadge.classList.remove('d-none');
      if (triggerBtn) {
        triggerBtn.className = 'btn btn-sm btn-outline-success';
        triggerBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Camera Ready';
      }
    } catch (err) {
      console.warn('Instructions camera init failed:', err);
      if (spinner)   spinner.classList.add('d-none');
      if (errorIcon) errorIcon.classList.remove('d-none');
      if (retryBtn)  retryBtn.classList.remove('d-none');
      if (title)     title.textContent = 'Allow Camera';
    }
  }

  // Automatic camera prompt on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstructionsCamera);
  } else {
    initInstructionsCamera();
  }

  // Release camera tracks upon test navigation
  window.addEventListener('beforeunload', () => {
    if (instStream) {
      instStream.getTracks().forEach(t => { try { t.stop(); } catch(e) {} });
      instStream = null;
    }
  });

  // Enable Start Test button only when instructions checkbox is checked
  const agreeCheck = document.getElementById('agreeCheck');
  const startBtn   = document.getElementById('startBtn');
  if (agreeCheck && startBtn) {
    agreeCheck.addEventListener('change', function () {
      if (this.checked) {
        startBtn.classList.remove('disabled');
        startBtn.style.pointerEvents = 'auto';
        startBtn.style.opacity = '1';
      } else {
        startBtn.classList.add('disabled');
        startBtn.style.pointerEvents = 'none';
        startBtn.style.opacity = '0.6';
      }
    });
  }
</script>
</body>
</html>
